<Window x:Class="WorkoutTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трекер тренировок" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Трекер тренировок" FontSize="24" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="15,10,0,5"/>

        <!-- Панель кнопок (ПР4: Добавить/Удалить, ПР5: ToolTips) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15,5">
            <Button x:Name="btnLoad" Content="Загрузить упражнения" Click="BtnLoad_Click"
                    ToolTip="Загрузить список упражнений из базы данных"
                    Padding="10,5" Margin="0,0,10,0" FontWeight="Bold"
                    Background="#3498DB" Foreground="White" BorderThickness="0"/>
            <Button x:Name="btnAdd" Content="Добавить упражнение" Click="BtnAdd_Click"
                    ToolTip="Открывает окно для добавления нового упражнения"
                    Padding="10,5" Margin="0,0,10,0" FontWeight="Bold"
                    Background="#27AE60" Foreground="White" BorderThickness="0"/>
            <Button x:Name="btnDelete" Content="Удалить выбранное" Click="BtnDelete_Click"
                    ToolTip="Удаляет выбранное упражнение (записи журнала удалятся каскадно)"
                    Padding="10,5" FontWeight="Bold"
                    Background="#E74C3C" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- ПР3: панель поиска и фильтрации -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="15,5">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="tbSearch" Width="200" VerticalAlignment="Center" Padding="3"/>
            <Button x:Name="btnSearch" Content="Найти" Click="BtnSearch_Click"
                    ToolTip="Искать по части названия упражнения"
                    Padding="10,5" Margin="5,0"/>
            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cmbCategory" Width="180" VerticalAlignment="Center"
                      SelectionChanged="CmbCategory_SelectionChanged"/>
            <Button x:Name="btnReset" Content="Сбросить" Click="BtnReset_Click"
                    ToolTip="Очистить поиск и фильтр, показать все упражнения"
                    Padding="10,5" Margin="10,0"/>
        </StackPanel>

        <!-- Таблица (ПР5: ToolTip + двойной клик) -->
        <DataGrid x:Name="dgExercises" Grid.Row="3" Margin="15,5"
                  AutoGenerateColumns="True" IsReadOnly="True"
                  AlternatingRowBackground="#F0F0F0"
                  MouseDoubleClick="DgExercises_MouseDoubleClick"
                  ToolTip="Двойной клик для редактирования упражнения"/>

        <!-- ПР5: обновлённый статус-бар -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="tbStatus" Text="Готово к работе"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="tbRecordCount" Text="Записей: 0" Margin="0,0,15,0"/>
                    <TextBlock Text="Двойной клик для редактирования"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
